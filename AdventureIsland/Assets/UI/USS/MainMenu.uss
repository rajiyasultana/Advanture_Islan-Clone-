.main-menu {
    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    background-color: rgb(148 243 195);
}

.title {
    font-size: 64px;
    -unity-font-style: bold;

    color: #000000;

    margin-bottom: 50px;
}

.menu-buttons {
    width: 300px;

    align-items: center;
}

.menu-button {
    width: 200px;
    height: 60px;

    margin-bottom: 15px;

    font-size: 24px;
    -unity-font-style: bold;

    color: white;

    background-color: rgb(9 180 118);

    border-width: 2px;
    border-color: rgb(100, 100, 100);

    border-radius: 25px;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgb(75, 75, 75);
}

.menu-button:active {
    background-color: rgb(100, 100, 100);
}